# This file exports the Galileo::Galileo CMake target which should be passed to the
# target_link_libraries command.

@PACKAGE_INIT@

include ("${CMAKE_CURRENT_LIST_DIR}/GalileoTargets.cmake")

# Legacy variables, do *not* use. May be removed in the future.

set (GALILEO_FOUND 1)
set (GALILEO_USE_FILE    "${CMAKE_CURRENT_LIST_DIR}/UseGalileo.cmake")

set (GALILEO_DEFINITIONS  "@GALILEO_DEFINITIONS@")
set (GALILEO_INCLUDE_DIR  "@PACKAGE_GALILEO_INCLUDE_DIR@")
set (GALILEO_INCLUDE_DIRS "@PACKAGE_GALILEO_INCLUDE_DIR@")
set (GALILEO_ROOT_DIR     "@PACKAGE_GALILEO_ROOT_DIR@")

set (GALILEO_VERSION_STRING "@GALILEO_VERSION_STRING@")
set (GALILEO_VERSION_MAJOR  "@GALILEO_VERSION_MAJOR@")
set (GALILEO_VERSION_MINOR  "@GALILEO_VERSION_MINOR@")
set (GALILEO_VERSION_PATCH  "@GALILEO_VERSION_PATCH@")